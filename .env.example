APP_NAME="AKALIN TECH E-COMMERCE"
APP_ENV=local
APP_KEY= # generate with: php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=Europe/Istanbul
APP_URL=http://localhost:2121

APP_PORT=2121

SANCTUM_STATEFUL_DOMAINS=localhost:000,localhost:0,akalintech.test:2121
SANCTUM_TOKEN_PREFIX=sanctum_token_prefix_
MOBILE_APP_URL=your-production-app-url

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=ecommerce
DB_USERNAME=sail
DB_PASSWORD=CHANGE_ME_USE_A_RANDOM_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Production defaults: Redis-backed queues and cache.
# Override locally when Redis is unavailable.
QUEUE_CONNECTION=redis
QUEUE_WORKER_QUEUE=default
QUEUE_RETRY_AFTER=90

CACHE_STORE=redis
CACHE_PREFIX=akalin_ecommerce_cache

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_HOST=your-smtp-host.com
MAIL_PORT=465
MAIL_USERNAME=your-mail-gmail
MAIL_PASSWORD=your-gmail-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="mygoogle@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SCOUT_DRIVER=typesense
SCOUT_QUEUE=true
SCOUT_AFTER_COMMIT=true
SCOUT_PREFIX=
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=CHANGE_ME_USE_A_RANDOM_SECRET
TYPESENSE_SEARCH_ONLY_KEY=CHANGE_ME_USE_A_PUBLIC_SEARCH_ONLY_KEY

IYZIPAY_API_KEY=your-iyzico-api-key
IYZIPAY_SECRET_KEY=your-iyzico-secret-key
IYZIPAY_BASE_URL=https://api.iyzipay.com

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=your-google-redirect-uri

FACEBOOK_CLIENT_ID=YOUR_FACEBOOK_CLIENT_ID
FACEBOOK_CLIENT_SECRET=YOUR_FACEBOOK_CLIENT_SECRET
FACEBOOK_REDIRECT=YOUR_FACEBOOK_REDIRECT

GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT=YOUR_GITHUB_REDIRECT
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

ADMIN_PASSWORD=CHANGE_ME_USE_A_RANDOM_PASSWORD
TEST_PASSWORD=CHANGE_ME_USE_A_RANDOM_PASSWORD
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_SECRET_ANDROID=
GOOGLE_REDIRECT_URI_ANDROID=
