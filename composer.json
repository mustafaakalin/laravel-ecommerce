{
    "name": "mustafaakalin/laravel-ecommerce",
    "type": "project",
    "description": "A feature-rich open-source e-commerce platform built with Laravel, Filament, Livewire, Tailwind CSS and Typesense.",
    "keywords": [
        "ecommerce",
        "e-commerce",
        "laravel",
        "filament",
        "livewire",
        "tailwindcss",
        "daisyui",
        "typesense",
        "shop"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "algolia/algoliasearch-client-php": "^4.39",
        "algolia/scout-extended": "^5.0",
        "bezhansalleh/filament-language-switch": "^5.0",
        "dutchcodingcompany/filament-socialite": "^3.2",
        "filament/filament": "^5.7",
        "google/apiclient": "^2.19",
        "guzzlehttp/guzzle": "^7.15",
        "iyzico/iyzipay-php": "^2.0",
        "laravel/framework": "^13.23",
        "laravel/sanctum": "^4.3",
        "laravel/scout": "^11.4",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "laraveldaily/laravel-invoices": "^4.2",
        "livewire/livewire": "^4.3",
        "owenvoke/blade-fontawesome": "^3.3",
        "php-http/curl-client": "^2.4",
        "predis/predis": "^3.5",
        "socialiteproviders/facebook": "^4.1",
        "socialiteproviders/instagram": "^5.2",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-permission": "^8.3",
        "stripe/stripe-php": "^21.0",
        "typesense/typesense-php": "^6.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "filament/upgrade": "^5.0",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.29",
        "laravel/sail": "^1.64",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve --port=2121\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
